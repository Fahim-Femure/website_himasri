# Salin file ini menjadi .env.local lalu isi dengan kredensial Firebase project Anda.
# Untuk pengembangan lokal dengan Firebase Emulator Suite, biarkan VITE_USE_EMULATORS=true.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-himasri.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-himasri
VITE_FIREBASE_STORAGE_BUCKET=demo-himasri.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo000000000000
VITE_USE_EMULATORS=true
# Opsional: App Check reCAPTCHA v3 site key untuk produksi
VITE_RECAPTCHA_SITE_KEY=
